# TBA works with NO keys at all: sentiment, topics, duplicate grouping, recommendations,
# images and the extractive Quick Read summary are all local. Every variable below is optional.
# Copy to .env; python app.py loads .env automatically with python-dotenv.
# NEVER commit a real .env file or paste a real key into this example file.

# ---- Server -------------------------------------------------------------------------------------
# HTTP port (macOS often has 5000 in use; try 5050)
PORT=5000
# 1 enables Flask debug mode (development only)
FLASK_DEBUG=0
# Identify your deployment to publishers; include a contact URL
TBA_USER_AGENT="Mozilla/5.0 (compatible; TBAReader/1.0; +https://example.org)"

# ---- Optional AI summary (any OpenAI-compatible /chat/completions API) ---------------------------
# Leave the key empty to use only the local extractive summary.
TBA_AI_API_KEY=
# Examples: https://api.openai.com/v1 | https://api.groq.com/openai/v1 | https://openrouter.ai/api/v1
#           http://localhost:11434/v1  (Ollama; plain http is accepted only for localhost)
TBA_AI_BASE_URL=https://api.openai.com/v1
TBA_AI_MODEL=gpt-4o-mini
# Seconds to wait for the model's reply (3-120)
TBA_AI_TIMEOUT=25
# Maximum article characters sent to the model (cost control)
TBA_AI_MAX_INPUT_CHARS=12000
# 1 = reject AI summaries containing names/numbers/quotes not found in the article (recommended)
TBA_AI_STRICT_GROUNDING=1

# ---- Local ML options ---------------------------------------------------------------------------
# vader (default, tiny, no download) or transformers (needs: pip install transformers torch; ~500 MB download)
TBA_SENTIMENT_BACKEND=vader
TBA_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# Cosine-similarity threshold for "same story" grouping (0.10-0.95). Higher = stricter. See README.md
TBA_DUPLICATE_THRESHOLD=0.50
# Related stories shown in the Quick Read modal (1-8)
TBA_RECOMMENDATIONS=4

# ---- Voice options -----------------------------------------------------------------------------
# Swara (female) and Madhur (male) need NO environment variables, model downloads,
# voice API key, or ONNX Runtime. Select voices from the Try Me interface.
# They require an internet connection and use an external Microsoft speech service.
# Optional local Piper (leave these unset unless Piper and matching models are installed):
# TBA_PIPER_MODEL=models/hi_IN-priyamvada-medium.onnx
# TBA_PIPER_ROHAN_MODEL=models/hi_IN-rohan-medium.onnx
# TBA_ENABLE_PARLER=0    # Optional large local model: requires separate setup/GPU

# Recommended for Render: direct RSS from Indian Express, The Hindu, BBC, NDTV and Guardian
TBA_NEWS_SOURCE=direct
TBA_RESOLVE_GOOGLE_LINKS=0
